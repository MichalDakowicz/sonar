# Shared with Radar on purpose: both apps read the same Supabase project, so
# accounts, profiles and friendships are the same rows in both.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify client-credentials app (metadata search only, no user login).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=

# Only needed by scripts/migrate-firebase.ts (one-off Firebase RTDB import).
FIREBASE_DATABASE_URL=
