# Ping self-hosted endpoint and publishable key only. Require a fresh sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Spotify credentials belong only in the server's protected function environment.
# Never put a Spotify secret or Supabase service-role key in public build inputs.

# Only needed by scripts/migrate-firebase.ts (one-off Firebase RTDB import).
FIREBASE_DATABASE_URL=
